# --- Centralized Safe OCR Text Getter ---
def get_active_ocr_text() -> str:
    """
    Safely retrieves the current active OCR text from session state or processed documents.
    Returns the real OCR output if available, or empty string if OCR has not been run.
    """
    # 1. First check if human-reviewed or edited OCR text exists
    rev = st.session_state.get("ocr_review_active_text")
    if isinstance(rev, str) and rev.strip():
        st.session_state["live_ocr_text"] = rev
        return rev

    # 2. Check directly stored live_ocr_text in session state
    s_live = st.session_state.get("live_ocr_text")
    if isinstance(s_live, str) and s_live.strip():
        return s_live

    # 3. Check Tesseract OCR result
    tess = st.session_state.get("tess_result")
    if isinstance(tess, dict):
        txt = tess.get("text")
        if isinstance(txt, str) and txt.strip():
            st.session_state["live_ocr_text"] = txt
            return txt

    # 4. Check Vision Transformer AI result
    ai = st.session_state.get("ai_result")
    if isinstance(ai, dict):
        txt = ai.get("text")
        if isinstance(txt, str) and txt.strip():
            st.session_state["live_ocr_text"] = txt
            return txt

    # 5. Check batch OCR results
    batch = st.session_state.get("batch_results")
    if isinstance(batch, list) and len(batch) > 0:
        first_b = batch[0]
        if isinstance(first_b, dict) and isinstance(first_b.get("text"), str) and first_b["text"].strip():
            st.session_state["live_ocr_text"] = first_b["text"]
            return first_b["text"]

    # 6. Check PDF page results
    pdf_pages = st.session_state.get("pdf_page_results")
    if isinstance(pdf_pages, list) and len(pdf_pages) > 0:
        first_p = pdf_pages[0]
        if isinstance(first_p, dict) and isinstance(first_p.get("text"), str) and first_p["text"].strip():
            st.session_state["live_ocr_text"] = first_p["text"]
            return first_p["text"]

    st.session_state["live_ocr_text"] = ""
    return ""


# Initialize live_ocr_text globally so all downstream tabs have safe, reliable access
