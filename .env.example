# =============================================================================
# தமிழ்ச்சுவடி AI – Environment Configuration Template (.env.example)
# Copy this file to .env and adjust values for your environment.
# Note: Zero credentials or paid API keys are required for core features!
# =============================================================================

# System Encoding (CRITICAL on Windows to prevent UnicodeEncodeError with Tamil script)
PYTHONIOENCODING=utf-8

# Application Port
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true

# AI Compute Device Selection ('auto', 'cuda', or 'cpu')
# Default 'auto' detects NVIDIA GPU if available; falls back smoothly to CPU.
AI_DEVICE=auto

# Optional: Path to custom Tesseract OCR traineddata directory
# If omitted, system defaults to PATH and standard installation paths.
# TESSDATA_PREFIX=C:\Program Files\Tesseract-OCR\tessdata

# Optional: Hugging Face User Access Token
# Only needed if downloading private fine-tuned checkpoints or avoiding rate limits.
# HF_TOKEN=your_huggingface_token_here

# Optional: Offline Mode (set to 'true' to disable remote TTS and run entirely offline)
OFFLINE_MODE=false
